diff --git a/data-raw/generate-io-yft-age-fits.R b/data-raw/generate-io-yft-age-fits.R
new file mode 100644
index 0000000..95ab012
--- /dev/null
+++ b/data-raw/generate-io-yft-age-fits.R
@@ -0,0 +1,41 @@
+# Fit the Indian Ocean yellowfin example with age-based selectivity
+# (sel_basis_f = 2), starting from SS3's own age_selex parameters, for the
+# io-yft-age-selectivity article. Run from the package root; takes several
+# minutes. Afterwards, rerun generate-io-yft-vignette-cache.R.
+#
+#   inst/extdata/io_yft_age_fit.rds      A: C2's map (49 selectivity
+#                                        parameters), age-based curves
+#   inst/extdata/io_yft_age_ss3_fit.rds  A-SS3: every selectivity parameter
+#                                        SS3 estimated (58)
+pkgload::load_all()
+source("data-raw/io-yft-age-setup.R")
+
+inputs <- io_yft_age_inputs()
+control <- list(eval.max = 10000, iter.max = 10000)
+metadata <- list(
+  stock = "Indian Ocean yellowfin (simulated, replicate 4)",
+  source = "SS3 model by M.N. Maunder, H. Xu and C. Minte-Vera (IATTC), converted to opal",
+  converter = "https://github.com/N-DucharmeBarth/wcpfc-bet-single-region (code/rtmb)")
+
+fits <- list(
+  io_yft_age_fit = list(
+    map = inputs$map_c2,
+    model = "A: SS3 age-specific K growth, opal age-based selectivity, C2's map"),
+  io_yft_age_ss3_fit = list(
+    map = inputs$map_ss3,
+    model = "A-SS3: as A, estimating every selectivity parameter SS3 estimated"))
+
+for (nm in names(fits)) {
+  x <- opal_obj(inputs$data, inputs$parameters, fits[[nm]]$map,
+                bounds = io_yft_age_bounds(inputs$parameters, fits[[nm]]$map),
+                control = control,
+                metadata = c(metadata, list(model = fits[[nm]]$model)))
+  t0 <- proc.time()[["elapsed"]]
+  x <- io_yft_fit_polished(x)
+  cat(sprintf("%s: objective %.4f, %d parameters, check %s, %.0f s\n", nm,
+              x$fit$opt$objective, length(x$fit$opt$par),
+              isTRUE(x$validation$fit$passes), proc.time()[["elapsed"]] - t0))
+  stopifnot(isTRUE(x$validation$fit$passes))
+  opal_save(x, file.path("inst", "extdata", paste0(nm, ".rds")),
+            compress = "xz", overwrite = TRUE)
+}
diff --git a/data-raw/generate-io-yft-c2-fit.R b/data-raw/generate-io-yft-c2-fit.R
new file mode 100644
index 0000000..0beb610
--- /dev/null
+++ b/data-raw/generate-io-yft-c2-fit.R
@@ -0,0 +1,34 @@
+# Recreate the stored Indian Ocean yellowfin fit used by the
+# io-yft-ss3-comparison article. Run from the package root; takes a few
+# minutes. The inputs (data/io_yft_*.rda) were exported from an SS3 model by
+# code/rtmb/scripts/04-export-io-yft-for-opal.r in
+# https://github.com/N-DucharmeBarth/wcpfc-bet-single-region.
+pkgload::load_all()
+
+x <- opal_obj(io_yft_data, io_yft_parameters, io_yft_map,
+              control = list(eval.max = 10000, iter.max = 10000))
+x <- opal_fit(x, n_passes = 2L, check = FALSE)
+
+# nlminb stops on relative function change, which for an objective near 1.4e4
+# leaves gradients of order 1e-3. A few Newton steps take them below 1e-8.
+object <- opal_rtmb(x, fresh = TRUE)
+opt <- x$fit$opt
+for (i in seq_len(5L)) {
+  g <- as.numeric(object$gr(opt$par))
+  if (max(abs(g)) < 1e-8) break
+  opt$par <- stats::setNames(opt$par - as.numeric(solve(object$he(opt$par), g)),
+                             names(opt$par))
+}
+opt$objective <- object$fn(opt$par)
+
+x <- opal_attach_fit(x, opt, check = TRUE,
+                     check_args = list(gradient_tolerance = 1e-4))
+stopifnot(isTRUE(x$validation$fit$passes))
+x <- opal_update(x, metadata = list(
+  stock = "Indian Ocean yellowfin (simulated, replicate 4)",
+  model = "C2: SS3 age-specific K growth, opal length-based selectivity",
+  source = "SS3 model by M.N. Maunder, H. Xu and C. Minte-Vera (IATTC), converted to opal",
+  converter = "https://github.com/N-DucharmeBarth/wcpfc-bet-single-region (code/rtmb)"))
+
+opal_save(x, "inst/extdata/io_yft_c2_fit.rds", compress = "xz", overwrite = TRUE)
+print(summary(x))
diff --git a/data-raw/generate-io-yft-vignette-cache.R b/data-raw/generate-io-yft-vignette-cache.R
new file mode 100644
index 0000000..aa22f1b
--- /dev/null
+++ b/data-raw/generate-io-yft-vignette-cache.R
@@ -0,0 +1,85 @@
+# Precompute what the Indian Ocean yellowfin articles plot, so that they
+# render in seconds without rebuilding the RTMB model:
+#
+#   inst/extdata/io_yft_vignette_cache.rds
+#
+# Read by vignettes/io-yft-ss3-comparison.qmd and
+# vignettes/io-yft-age-selectivity.qmd. Run from the package root after
+# generate-io-yft-c2-fit.R or generate-io-yft-age-fits.R, or after any change
+# to opal's model code (about a minute: one model build per entry).
+pkgload::load_all()
+source("data-raw/io-yft-age-setup.R")
+
+d <- io_yft_data
+n_ts <- d$n_year
+read_fit <- function(file) opal_read(file.path("inst", "extdata", file))
+
+# Everything the articles take from one model: report quantities as plain
+# data frames, and the fit statistics when the model has been fitted.
+extract <- function(x) {
+  object <- opal_rtmb(x, fresh = TRUE)
+  par <- if (is.null(x$fit$opt)) object$par else x$fit$opt$par
+  report <- object$report(par)
+  sel <- report$sel_fya[, 1, ]
+  lf <- do.call(rbind, lapply(seq_along(d$lf_fishery_f), function(j) {
+    n <- d$lf_n_fi[[j]]
+    data.frame(fishery = d$lf_fishery_f[j], bin = d$len_lower,
+               predicted = colSums(report$lf_pred[[j]] * n) / sum(n))
+  }))
+  traj <- data.frame(ts = seq_len(n_ts),
+                     ssb = report$spawning_biomass_y[seq_len(n_ts)],
+                     static_dep = report$static_depletion_y[seq_len(n_ts)])
+  fit <- if (is.null(x$fit$opt)) NULL else list(
+    n_par = length(x$fit$opt$par),
+    objective = x$fit$opt$objective,
+    max_gradient = x$validation$fit$metrics$max_gradient,
+    passes = isTRUE(x$validation$fit$passes),
+    summary = utils::capture.output(summary(x)))
+  list(
+    B0 = report$B0,
+    objective = as.numeric(object$fn(par)),
+    nll = c(index = sum(report$lp_cpue), length = sum(report$lp_lf),
+            recruitment = sum(report$lp_rec), prior = sum(report$lp_prior),
+            penalty = sum(report$lp_penalty)),
+    trajectory = traj,
+    sel_age = data.frame(fishery = rep(seq_len(nrow(sel)), times = ncol(sel)),
+                         age = rep(d$age_a, each = nrow(sel)), sel = as.vector(sel)),
+    cpue = data.frame(ts = d$cpue_data$ts, fishery = d$cpue_data$fishery,
+                      pred = report$cpue_pred),
+    lf = lf,
+    rdev = unname(par[grepl("^rdev_y", names(par))]),
+    sel_free = sum(grepl("^par_sel", names(par))),
+    fit = fit)
+}
+
+inputs <- io_yft_age_inputs()
+sa <- io_yft_reference$ss3$sel_age
+external_data <- inputs$data
+external_data$sel_fa_external <- matrix(0, d$n_fishery, d$n_age)
+external_data$sel_fa_external[cbind(sa$fishery, match(sa$age, d$age_a))] <- sa$sel
+models <- list(
+  C2 = read_fit("io_yft_c2_fit.rds"),
+  A = read_fit("io_yft_age_fit.rds"),
+  A_ss3 = read_fit("io_yft_age_ss3_fit.rds"),
+  # Age-based selectivity at SS3's values, everything else at SS3's
+  # solution, not fitted: the bridging check.
+  A_start = opal_obj(inputs$data, inputs$parameters, inputs$map_c2,
+                     bounds = io_yft_age_bounds(inputs$parameters, inputs$map_c2)),
+  # The same, with SS3's selectivity-at-age supplied as a fixed matrix
+  E_start = opal_obj(external_data, inputs$parameters, inputs$map_c2,
+                     bounds = io_yft_age_bounds(inputs$parameters, inputs$map_c2)))
+
+cache <- list(
+  created = format(Sys.time(), tz = "UTC", usetz = TRUE),
+  opal = as.character(utils::packageVersion("opal")),
+  commit = tryCatch(system2("git", c("rev-parse", "--short", "HEAD"), stdout = TRUE),
+                    error = function(e) NA_character_),
+  models = lapply(models, extract))
+
+saveRDS(cache, file.path("inst", "extdata", "io_yft_vignette_cache.rds"),
+        compress = "xz", version = 3L)
+for (nm in names(cache$models)) {
+  m <- cache$models[[nm]]
+  cat(sprintf("%-8s objective %.4f, B0 %.4g, terminal depletion %.3f\n", nm,
+              m$objective, m$B0, m$trajectory$static_dep[n_ts]))
+}
diff --git a/data-raw/io-yft-age-setup.R b/data-raw/io-yft-age-setup.R
new file mode 100644
index 0000000..a89c26a
--- /dev/null
+++ b/data-raw/io-yft-age-setup.R
@@ -0,0 +1,95 @@
+# Age-based selectivity inputs for the Indian Ocean yellowfin example, shared
+# by generate-io-yft-age-fits.R and generate-io-yft-vignette-cache.R. The
+# io-yft-age-selectivity article shows the same steps.
+#
+# io_yft_age_inputs() returns the data with sel_basis_f = 2 for every
+# fishery, par_sel converted from SS3's age_selex parameters, and two maps:
+#   map_c2   C2's map: the same 49 selectivity parameters as the
+#            length-based fit, so the basis is the only difference;
+#   map_ss3  every selectivity parameter SS3 estimated (phase > 0): C2's
+#            49 plus the nine C2 fixes.
+
+# Unadjusted descending limb of opal's double normal at the last x, as in
+# sel_double_normal()
+dn_unadjusted_end <- function(par, x) {
+  n <- length(x)
+  bin_width <- x[2] - x[1]
+  peak <- mean(x) + par[1] * sd(x)
+  peak2 <- peak + bin_width + (0.99 * x[n] - peak - bin_width) / (1 + exp(-par[2]))
+  exp(-(x[n] - peak2)^2 / (exp(par[4]) * sd(x)^2))
+}
+
+io_yft_age_inputs <- function() {
+  d <- io_yft_data
+  p <- io_yft_parameters
+  ref <- io_yft_reference
+  sp <- ref$ss3$sel_par
+  pat <- ref$ss3$sel_pattern
+
+  # SS3 fleet whose parameters each opal fishery uses: fisheries 1-16 are
+  # SS3 fleets 1-16 (15 and 16 mirror 14 through pattern 15), and the four
+  # quarterly index series 17-20 are SS3's survey, fleet 17.
+  ss3_fleet <- c(seq_len(16), rep(17L, 4))
+  mirror <- pat$pattern[ss3_fleet] == 15L
+  ss3_fleet[mirror] <- pat$special[ss3_fleet[mirror]]
+
+  ss3_pars <- t(vapply(ss3_fleet, function(fl) {
+    v <- sp$value[sp$fleet == fl]
+    c(v, rep(0, 6 - length(v)))
+  }, numeric(6)))
+
+  d$sel_basis_f <- rep(2L, d$n_fishery)
+  p$par_sel <- convert_ss3_selex_to_rtmb(ss3_pars, d$sel_type_f,
+                                         sel_lengths = d$len_mid,
+                                         basis = "age", sel_ages = d$age_a)
+  # SS3's final selectivity of -999 ("no adjustment") becomes -9 above.
+  # Setting it to the unadjusted curve's own value at the oldest age
+  # reproduces "no adjustment" exactly.
+  for (f in which(d$sel_type_f == 2L & ss3_pars[, 6] <= -999)) {
+    p$par_sel[f, 6] <- max(stats::qlogis(dn_unadjusted_end(p$par_sel[f, ], d$age_a)), -20)
+  }
+
+  # Every parameter SS3 estimated, with SS3's mirrors
+  est <- matrix(NA_integer_, d$n_fishery, 6)
+  k <- 0L
+  for (fl in unique(ss3_fleet)) {
+    cols <- sp$par[sp$fleet == fl & sp$phase > 0]
+    ids <- k + seq_along(cols)
+    k <- k + length(cols)
+    for (f in which(ss3_fleet == fl)) est[f, cols] <- ids
+  }
+  map_ss3 <- io_yft_map
+  map_ss3$par_sel <- factor(as.vector(est))
+
+  list(data = d, parameters = p, map_c2 = io_yft_map, map_ss3 = map_ss3,
+       ss3_fleet = ss3_fleet, ss3_pars = ss3_pars)
+}
+
+# opal's default bounds, with par_sel widened from +/-7 to +/-20 (SS3's
+# bounds for P2-P4): on the age scale, SS3's plateau and ascending widths
+# for several fisheries are near -10 to -15.
+io_yft_age_bounds <- function(parameters, map, lim = 20) {
+  active <- unlist(lapply(names(parameters), function(n)
+    rep(n, if (is.null(map[[n]])) length(parameters[[n]]) else nlevels(droplevels(map[[n]])))))
+  b <- get_bounds(list(par = stats::setNames(numeric(length(active)), active)), parameters)
+  b$lower[b$parameter == "par_sel"] <- -lim
+  b$upper[b$parameter == "par_sel"] <- lim
+  b
+}
+
+# Two nlminb passes, Newton steps to take the gradient below 1e-8, and
+# opal_check(), as in generate-io-yft-c2-fit.R.
+io_yft_fit_polished <- function(x) {
+  x <- opal_fit(x, n_passes = 2L, check = FALSE)
+  object <- opal_rtmb(x, fresh = TRUE)
+  opt <- x$fit$opt
+  for (i in seq_len(5L)) {
+    g <- as.numeric(object$gr(opt$par))
+    if (max(abs(g)) < 1e-8) break
+    opt$par <- stats::setNames(opt$par - as.numeric(solve(object$he(opt$par), g)),
+                               names(opt$par))
+  }
+  opt$objective <- object$fn(opt$par)
+  opal_attach_fit(x, opt, check = TRUE,
+                  check_args = list(gradient_tolerance = 1e-4))
+}
