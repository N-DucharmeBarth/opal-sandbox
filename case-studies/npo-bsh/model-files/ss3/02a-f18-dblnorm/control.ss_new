           -25            25      -8.52519             0             1             0         -1          0          0          0          0          0          0          0  #  LnQ_base_S5_JPN_EARLY(25)
           -25            25      -8.38434             0             1             0         -1          0          0          0          0          0          0          0  #  LnQ_base_S6_JPN_LATE(26)
           -25            25      -7.71055             0             1             0         -1          0          0          0          0          0          0          0  #  LnQ_base_S7_JPN_RTV(27)
